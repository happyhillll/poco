{
  "name": "poco-canvas",
  "version": "1.0.0",
  "private": true,
  "description": "Poco 화면 캔버스 (Claude Design 내보내기) 로컬 실행용",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "dev": "node scripts/vendor.mjs && serve public --listen 5175 --no-clipboard",

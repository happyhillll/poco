    "preview": "serve docs --listen 4175 --no-clipboard"
  },
  "dependencies": {
    "@babel/standalone": "7.29.0",
    "@fontsource/noto-sans-kr": "^5.2.0",
    "@fontsource/noto-serif-kr": "^5.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
